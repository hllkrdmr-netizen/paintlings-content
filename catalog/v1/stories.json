 "stories": [
  {
   "id": "lighthouse",
   "access": "free",
   "title": {
    "en": "Lighthouse",
    "tr": "Deniz Feneri",
    "de": "Leuchtturm"
   },
   "cardSub": {
    "en": "The last light at sunset",
    "tr": "Gün batımında son ışık",
    "de": "Das letzte Licht bei Sonnenuntergang"
   },
   "intro": {
    "en": "The sun is setting. The old lighthouse is about to shine one last time.",
    "tr": "Güneş batıyor. Yaşlı fener son kez yanmak üzere.",
    "de": "Die Sonne geht unter. Der alte Leuchtturm leuchtet ein letztes Mal."
   },
   "scene": "art/stories/lighthouse/final.png",
   "chapters": [
    {
     "n": 1,
     "game": "dots",
     "line": {
      "en": "Draw the lighthouse with the dots.",
      "tr": "Fenerin silüetini noktalarla çiz.",
      "de": "Zeichne den Leuchtturm mit den Punkten."
     },
     "content": "stories/lighthouse#dots"
    },
    {
     "n": 2,
     "game": "spot",
     "line": {
      "en": "What changed on the shore tonight? Find it.",
      "tr": "Akşam kıyıda ne değişti? Bul.",
      "de": "Was hat sich heute Abend am Ufer verändert?"
     },
     "content": "stories/lighthouse#spot"
    },
    {
     "n": 3,
     "game": "jigsaw",
     "line": {
      "en": "Put the scattered postcard back together.",
      "tr": "Dağılan kartpostalı topla.",
      "de": "Setze die verstreute Postkarte zusammen."
     },
     "content": "stories/lighthouse#jigsaw"
    },
    {
     "n": 4,
     "game": "hidden",
     "line": {
      "en": "Reveal the boat in the mist.",
      "tr": "Sisteki kayığı ortaya çıkar.",
      "de": "Enthülle das Boot im Nebel."
     },
     "file": "art/stories/lighthouse/hidden.json"
    },
    {
     "n": 5,
     "game": "paint",
     "line": {
      "en": "Paint the sunset and light the lighthouse again.",
      "tr": "Gün batımını boya, fener yeniden yansın.",
      "de": "Male den Sonnenuntergang, lass den Leuchtturm wieder leuchten."
     },
     "file": "art/stories/lighthouse/final.json"
    }
   ],
   "status": "ready"
  },
  {
   "id": "winter-village",
